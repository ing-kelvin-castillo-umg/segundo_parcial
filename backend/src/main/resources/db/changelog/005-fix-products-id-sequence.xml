<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Los productos semilla (004) se insertaron con ID explícito, por lo que la secuencia
         quedó en 1 y el primer INSERT desde la API fallaba con "duplicate key pk_products".
         Se sincroniza la secuencia con el mayor ID existente. No modifica ni elimina datos. -->
    <changeSet id="005-1-sync-products-id-sequence" author="umg">
        <sql>
            SELECT setval(pg_get_serial_sequence('products', 'id'), (SELECT COALESCE(MAX(id), 1) FROM products));
        </sql>
    </changeSet>

</databaseChangeLog>
