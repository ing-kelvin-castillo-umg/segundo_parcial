<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Lista de revocación de access tokens. Un JWT es autocontenido y seguiría
        siendo válido hasta su vencimiento; registrar aquí su jti permite matar la
        sesión de inmediato al cerrarla por inactividad o de forma manual.
    -->
    <changeSet id="007-1-create-revoked-access-tokens-table" author="umg">
        <createTable tableName="revoked_access_tokens">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_revoked_access_tokens"/>
            </column>
            <column name="jti" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_revoked_access_tokens_jti"/>
            </column>
            <column name="username" type="VARCHAR(50)"/>
            <column name="expires_at" type="TIMESTAMP"/>
            <column name="revoked_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
